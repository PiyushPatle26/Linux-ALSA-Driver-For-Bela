// SPDX-License-Identifier: GPL-2.0
/*
 * PocketBeagle2 + Bela Gem Multi audio overlay
 *
 * Targets the custom machine driver am625-bela-gem.c
 * (compatible "ti,am625-bela-gem-multi").
 *
 * Codecs on main_i2c1 (bus shows as /dev/i2c-2):
 *   TLV320AIC3106  @0x18  — stereo I/O, clock slave (BCLK/WCLK from McASP)
 *   ES9080Q        @0x48  — 8-channel DAC, clock slave (write-only @0x4c)
 *   TLV320ADC3140  @0x4e  — 4-channel ADC #1, clock slave (capture)
 *   TLV320ADC3140  @0x4f  — 4-channel ADC #2, clock slave (capture)
 *   (ADC addresses confirmed with `i2cdetect -y 2` at bring-up; adjust reg if needed.)
 *
 * Clock topology (McASP is BCLK+WCLK master; AIC3106 and all other codecs are
 * clock slaves on the TDM bus):
 *   audio_refclk1 (12.288 MHz) -> P2.11 MCLK -> codec MCLK inputs
 *   mcasp2 fck (24.576 MHz, pinned via assigned-clock-rates) divided by 2 ->
 *   P2.19 BCLK (12.288 MHz) + P2.10 WCLK (48 kHz) -> all codec BCLK/WCLK inputs
 *   Machine driver does clk_get(dev,"mclk") + clk_prepare_enable(), so the
 *   sound node carries clocks=<&audio_refclk1>, clock-names="mclk".
 *
 * Shared McASP2 frame: 8 slots x 32-bit, DSP_B (TDM). Each codec uses its OWN
 * serializer (data pin) and emits/consumes its channels from slot 0 of that line:
 *   AXR0 (P2.05) TX -> TLV DIN   (playback, slots 0-1)
 *   AXR1 (P2.07) RX <- TLV DOUT  (capture,  slots 0-1)
 *   AXR6 (P1.04) TX -> ES9080Q DIN1 (8ch TDM8, slots 0-7; single data line)
 *   AXR4 (P1.02) RX <- ADC3140 #1 DOUT (4ch, slots 0-3)
 *   AXR8 (P2.31) RX <- ADC3140 #2 DOUT (4ch, slots 0-3)
 *
 * AXR direction = hardware ground truth (scope under Bela runtime + validated
 * Stereo overlay): AXR0=TX, AXR1=RX. serial-dir convention: 0=off, 1=TX, 2=RX.
 *
 * Pin map (PocketBeagle2 header -> AM62 pad, verified vs PB2-BELA.dtso):
 *   P1.33 I2C1_SDA   P1.36 I2C1_SCL
 *   P2.05 AXR0  P2.07 AXR1  P1.04 AXR6  P1.02 AXR4  P2.31 AXR8
 *   P2.10 AFSX/WCLK(out) P2.19 ACLKX/BCLK(out) P2.11 AUDIO_EXT_REFCLK1/MCLK(out)
 *   P2.18 GPIO0_53 -> ES9080 CHIP_EN / ADC_RST# (hogged active, needs JP8 bridged)
 */

#include <dt-bindings/gpio/gpio.h>
#include "k3-pinctrl.h"

/dts-v1/;
/plugin/;

&{/chosen} {
	overlays {
		k3-am62-pocketbeagle2-bela-gem-multi.kernel = __TIMESTAMP__;
	};
};

/* Regulators + machine-driver sound card */
&{/} {
	bela_vdda_3v3: regulator-bela-vdda-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "bela_vdda_3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vdd_3v3>;
		regulator-always-on;
		regulator-boot-on;
	};

	bela_vdd_1v8: regulator-bela-vdd-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "bela_vdd_1v8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vdd_3v3>;
		regulator-always-on;
		regulator-boot-on;
	};

	bela_multi_sound: sound {
		compatible = "ti,am625-bela-gem-multi";
		model = "BelaGemMulti";

		cpu-dai        = <&mcasp2>;
		aic3106-codec  = <&tlv320aic3106>;
		es9080q-codec  = <&es9080q>;
		adc3140-1-codec = <&adc3140_1>;
		adc3140-2-codec = <&adc3140_2>;

		/* machine driver: devm_clk_get(dev, "mclk") + clk_prepare_enable() */
		clocks = <&audio_refclk1>;
		clock-names = "mclk";
	};
};

&main_pmx0 {
	bela_multi_i2c1_pins: bela-multi-i2c1-pins {
		pinctrl-single,pins = <
			AM62X_IOPAD(0x01e8, PIN_INPUT_PULLUP, 0) /* (B17) I2C1_SCL, P1.36 AUD_SCL */
			AM62X_IOPAD(0x01ec, PIN_INPUT_PULLUP, 0) /* (A17) I2C1_SDA, P1.33 AUD_SDA */
		>;
	};

	/* I2C pull-up compensation (marginal cape routing) — as PB2-BELA.dtso */
	bela_multi_i2c1_pullup_sda: bela-multi-i2c1-pullup-sda-pins {
		pinctrl-single,pins = <
			AM62X_IOPAD(0x00e4, PIN_INPUT_PULLUP, 7) /* (AA23) GPIO0_56 pullup for SDA */
		>;
	};
	bela_multi_i2c1_pullup_scl: bela-multi-i2c1-pullup-scl-pins {
		pinctrl-single,pins = <
			AM62X_IOPAD(0x00e0, PIN_INPUT_PULLUP, 7) /* (V20) GPIO0_55 pullup for SCL */
		>;
	};

	bela_multi_audio_pins: bela-multi-audio-pins {
		pinctrl-single,pins = <
			AM62X_IOPAD(0x01d8, PIN_OUTPUT, 8) /* (C15) MCASP2_AXR0, P2.05 TX -> TLV DIN (playback) */
			AM62X_IOPAD(0x01dc, PIN_INPUT,  8) /* (E15) MCASP2_AXR1, P2.07 RX <- TLV DOUT (capture) */
			AM62X_IOPAD(0x0174, PIN_OUTPUT, 2) /* (AD21) MCASP2_AFSX,  P2.10 WCLK (McASP-driven, frame master) */
			AM62X_IOPAD(0x0178, PIN_OUTPUT, 2) /* (AC20) MCASP2_ACLKX, P2.19 BCLK (McASP-driven, bit-clock master) */
			AM62X_IOPAD(0x016c, PIN_OUTPUT, 2) /* (Y18) MCASP2_AXR6,  P1.04 TX -> ES9080Q DIN1 (8ch) */
			AM62X_IOPAD(0x0164, PIN_INPUT,  2) /* (AA19) MCASP2_AXR4, P1.02 RX <- ADC3140 #1 DOUT */
			AM62X_IOPAD(0x0170, PIN_INPUT,  5) /* (AA18) MCASP2_AXR8, P2.31 RX <- ADC3140 #2 DOUT */
		>;
	};

	bela_multi_mclk_pins: bela-multi-mclk-pins {
		pinctrl-single,pins = <
			AM62X_IOPAD(0x01d4, PIN_OUTPUT, 5) /* (B15) AUDIO_EXT_REFCLK1, P2.11 MCLK out */
		>;
	};

	bela_multi_ctrl_pins: bela-multi-ctrl-pins {
		pinctrl-single,pins = <
			AM62X_IOPAD(0x00d8, PIN_OUTPUT, 7) /* (V21) GPIO0_53, P2.18 ES9080 CHIP_EN / ADC_RST# */
		>;
	};
};

&audio_refclk1 {
	/* 12.288 MHz (96 MHz / 8). Machine driver enables this as "mclk". */
	assigned-clock-rates = <12288000>;
	pinctrl-names = "default";
	pinctrl-0 = <&bela_multi_mclk_pins>;
};

/*
 * GPIO0_53 (P2.18) is a SHARED codec control line:
 *   - ES9080Q CHIP_EN       (active-high enable, via JP8)
 *   - TLV320ADC3140 RESETN  (active-low reset, same physical net)
 *
 * It must be driven STATICALLY HIGH and held there. A static gpio-hog
 * (ACTIVE_LOW + output-low => raw pad HIGH) enables the ES9080Q and
 * simultaneously holds both ADC3140s out of reset. It must NOT be used as a
 * pulsed reset-gpios: asserting it low to "reset" the ADCs also drops ES9080Q
 * CHIP_EN, which then fails its I2C probe with -121 (EREMOTEIO). The ADCs do
 * not need a reset pulse here -- their supplies are stable at boot, so a
 * static raw-HIGH releases them cleanly.
 */
&main_gpio0 {
	pinctrl-names = "default";
	pinctrl-0 = <&bela_multi_ctrl_pins>;

	bela_codec_enable {
		gpio-hog;
		gpios = <53 GPIO_ACTIVE_LOW>;
		output-low;	/* ACTIVE_LOW + output-low => raw pad HIGH */
		line-name = "bela-codec-enable";
	};
};

&main_i2c1 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&bela_multi_i2c1_pins>,
		    <&bela_multi_i2c1_pullup_sda>,
		    <&bela_multi_i2c1_pullup_scl>;

	tlv320aic3106: audio-codec@18 {
		compatible = "ti,tlv320aic3106";
		reg = <0x18>;
		#sound-dai-cells = <0>;
		clocks = <&audio_refclk1>;
		AVDD-supply  = <&bela_vdda_3v3>;
		DVDD-supply  = <&bela_vdd_1v8>;
		DRVDD-supply = <&bela_vdda_3v3>;
		IOVDD-supply = <&vdd_3v3>;
	};

	es9080q: dac@48 {
		compatible = "ess,es9080q";
		reg = <0x48>;
		#sound-dai-cells = <0>;
		ess,write-only-addr = <0x4c>;
		clocks = <&audio_refclk1>;
		clock-names = "mclk";
	};

	/*
	 * TLV320ADC3140 quad-channel ADCs. Both are TDM/DSP_B capture slaves,
	 * clocked by the AIC3106 BCLK/WCLK. Each drives its own McASP RX
	 * serializer (AXR4 / AXR8). avdd = 3.3V, iovdd = 3.3V (board rails).
	 * The on-chip areg LDO supplies the 1.8V analog domain (no "areg" phandle).
	 * RESETN shares GPIO0_53 with ES9080 CHIP_EN and is held HIGH by the
	 * bela_codec_enable hog above. We deliberately do NOT use reset-gpios here:
	 * a pulsed reset would also drop ES9080Q CHIP_EN and break its probe.
 */
	adc3140_1: adc@4e {
		compatible = "ti,tlv320adc3140";
		reg = <0x4e>;
		#sound-dai-cells = <0>;
		avdd-supply  = <&bela_vdda_3v3>;
		iovdd-supply = <&vdd_3v3>;
	};

	adc3140_2: adc@4f {
		compatible = "ti,tlv320adc3140";
		reg = <0x4f>;
		#sound-dai-cells = <0>;
		avdd-supply  = <&bela_vdda_3v3>;
		iovdd-supply = <&vdd_3v3>;
	};
};

/* McASP2 — shared TDM bus, BCLK/WCLK slave to TLV320AIC3106 */
&mcasp2 {
	#sound-dai-cells = <0>;
	pinctrl-names = "default";
	pinctrl-0 = <&bela_multi_audio_pins>;
	status = "okay";

	/*
	 * McASP2 is the BCLK + WCLK (frame) master for the whole TDM bus; all
	 * codecs are clock consumers. A stereo codec (TLV320AIC3106) cannot
	 * master a frame wider than its 2 channels, so the McASP generates the
	 * 8-slot frame instead. The functional clock is pinned to 24.576 MHz
	 * below, and the machine driver passes the same rate via set_sysclk so
	 * the McASP programs the BCLK divider: 24.576 MHz / 2 = 12.288 MHz
	 * (= 256 * 48 kHz = 8 slots * 32 bits * 48 kHz). auxclk-fs-ratio is
	 * also present for rate-constraint negotiation but is not sufficient
	 * alone (does not program the BCLK divider hardware).
	 */
	assigned-clocks = <&k3_clks 192 0>;
	assigned-clock-rates = <24576000>;

	auxclk-fs-ratio = <256>;

	op-mode   = <0>;     /* DAVINCI_MCASP_IIS_MODE */
	tdm-slots = <8>;     /* 8 x 32 = 256 BCLK/frame (= Bela kNumBits 256); machine driver re-programs masks per link */

	/*
	 * serial-dir convention: 0=inactive, 1=TX, 2=RX (AXR index = position).
	 *   AXR0 (P2.05) = TX (1) -> TLV DIN   (playback)
	 *   AXR1 (P2.07) = RX (2) <- TLV DOUT  (capture)
	 *   AXR4 (P1.02) = RX (2) <- ADC3140 #1 DOUT
	 *   AXR6 (P1.04) = TX (1) -> ES9080Q DIN1
	 *   AXR8 (P2.31) = RX (2) <- ADC3140 #2 DOUT
 */
	serial-dir = <
		1 2 0 0     /* AXR0=TX, AXR1=RX, AXR2=off, AXR3=off */
		2 0 1 0     /* AXR4=RX, AXR5=off, AXR6=TX, AXR7=off */
		2 0 0 0     /* AXR8=RX, ... */
		0 0 0 0
	>;

	tx-num-evt = <1>;
	rx-num-evt = <1>;
};
