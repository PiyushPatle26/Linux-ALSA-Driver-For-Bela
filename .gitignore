/linux/
# Staged module install root / packaging output.
/build/
# Editor/agent scratch + planning notes.
/.embedder/
/.claude/

# ---------------------------------------------------------------------------
# Large binaries and local-only documents
# ---------------------------------------------------------------------------
*.pdf
/docs/

